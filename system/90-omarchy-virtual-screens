#!/bin/bash
# Virtual Screens (Omarchy plugin jebin2.virtual-screens): open Sunshine's ports
# on Wi-Fi only while connected to a trusted Wi-Fi, and only for its own subnet.
# Any other network, or Wi-Fi going down, closes them again.
# Trusted networks: NetworkManager connection UUIDs in
# /etc/omarchy-virtual-screens/trusted-wifi, managed from the panel.
TRUSTED=/etc/omarchy-virtual-screens/trusted-wifi
BASES=$(cat /etc/omarchy-virtual-screens/bases 2>/dev/null)  # screens 2, 3, 4 (written by setup)
[[ $BASES =~ ^[0-9\ ]+$ ]] || BASES="48089 48189 48289"
STATE=/var/lib/omarchy-virtual-screens/wifi-rules  # rules added; survives reboots
FLAG=/run/omarchy-virtual-screens/wifi-open        # exists while open (read by the panel)

IFACE=$1 ACTION=$2

close() {
  if [[ -f $STATE ]]; then
    while read -r spec; do [[ -n $spec ]] && ufw --force delete allow $spec >/dev/null 2>&1; done < "$STATE"
    rm -f "$STATE"
  fi
  rm -f "$FLAG"
}

open() {
  local net b p
  net=$(ip -4 route show dev "$IFACE" proto kernel scope link | awk 'NR==1{print $1}')
  [[ $net =~ ^[0-9.]+/[0-9]+$ ]] || return
  mkdir -p "${STATE%/*}" "${FLAG%/*}"
  for b in $BASES; do
    for p in $((b - 5)) "$b" $((b + 21)); do echo "in on $IFACE from $net to any port $p proto tcp"; done
    for p in $((b + 9)):$((b + 11)) $((b + 13)) $((b + 21)); do echo "in on $IFACE from $net to any port $p proto udp"; done
  done > "$STATE"
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
    while read -r spec; do ufw allow $spec comment omarchy-virtual-screens-wifi >/dev/null; done < "$STATE"
  fi
  touch "$FLAG"
}

case $ACTION in
  up|dhcp4-change)
    [[ $IFACE == wl* ]] || exit 0
    close
    grep -qx "${CONNECTION_UUID:-none}" "$TRUSTED" 2>/dev/null && open ;;
  down|pre-down)
    [[ $IFACE == wl* || $IFACE == none ]] || exit 0
    close ;;
esac
exit 0
