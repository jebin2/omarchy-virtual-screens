# Virtual Screens (Omarchy plugin jebin2.virtual-screens): name Android USB
# tethering links tether0, tether1, ... so the firewall can allow the virtual
# screens on "tether+" without opening any other wired network.
# Only RNDIS (what Android's USB tethering uses). Phones that tether with NCM
# share the cdc_ncm driver with USB-C docks' Ethernet, so they're left out on
# purpose: a dock must keep working as a normal network. See README.md.
SUBSYSTEM=="net", ACTION=="add", DRIVERS=="rndis_host", NAME="tether%n"
