#!/bin/bash
# Virtual Screens for Omarchy: extra screens shown on other devices (tablet,
# phone, laptop) with Sunshine (here) + Moonlight (on the device).
# Everything is automatic: config, login, pairing, and the screen's resolution.
#
#   virtual-screen [N] [start|stop|toggle|status]   N = 2, 3 or 4 (default 2)
#   virtual-screen [N] pair PIN [NAME]              type the PIN Moonlight shows
#   virtual-screen [N] forget UUID                  unpair a device
#   virtual-screen [N] audio laptop|device          where that screen's sound plays
#   virtual-screen info-all                         JSON for the bar panel
#   virtual-screen status-all                       "N on|off" for every screen
#   virtual-screen uninstall                        remove everything (asks for the password)
#   virtual-screen [N] fit                          (Sunshine calls this) resize SCREEN-N
#                                                   to the connecting device
#   virtual-screen [N] report                       URL of a pre-filled GitHub issue for
#                                                   screen N's last failure
#   virtual-screen issue-url TITLE DETAILS          URL of a pre-filled GitHub issue
#
# Screen N is a virtual Hyprland output SCREEN-N streamed by its own Sunshine
# instance in ~/.config/virtual-screens/screen-N/, on ports
# 47984+100*(N-1) .. 48010+100*(N-1) (screen 2: 48084-48110). These are not
# Sunshine's default ports, so a normal Sunshine install keeps working beside it.
# One generated login (~/.config/virtual-screens/login, 0600) is set on every
# instance by writing its state file directly, so the password never shows up
# in any process's arguments; pairing goes through each instance's local API
# (https://127.0.0.1:<port+1>, reachable from this laptop only).
#
# The system part (firewall, USB naming, Wi-Fi rules) is installed once by
# virtual-screen-root, see README.md.
set -uo pipefail

SCREENS=(2 3 4)
REPO=jebin2/omarchy-virtual-screens
PLUGIN_ID=jebin2.virtual-screens
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname "$SELF")"
CONF_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/virtual-screens"
LOGIN_FILE="$CONF_ROOT/login"
RUN_ROOT="${XDG_RUNTIME_DIR:-/tmp}/virtual-screens"
SYS_DIR=/etc/omarchy-virtual-screens
LIBEXEC=/usr/local/libexec/omarchy-virtual-screens-root
WIFI_FLAG=/run/omarchy-virtual-screens/wifi-open
# The system part this version expects; must match VERSION in virtual-screen-root.
SYSTEM_VERSION=2

ordinal() { case $1 in 2) echo Second ;; 3) echo Third ;; 4) echo Fourth ;; *) echo "Screen $1" ;; esac; }

setup() {
  N=$1
  NAME="SCREEN-$N"
  CONF_DIR="$CONF_ROOT/screen-$N"
  CONF="$CONF_DIR/sunshine.conf"
  BASE=$((47989 + (N - 1) * 100))
  API="https://127.0.0.1:$((BASE + 1))"
  RUN="$RUN_ROOT/$N"
  TITLE="$(ordinal "$N") screen"
  mkdir -p "$RUN"
}

notify() { notify-send -a "Virtual screens" "${TITLE:-Virtual screens}" "$1" 2>/dev/null; echo "$1"; }

# A failure the panel shows with a "Report on GitHub" button.
fail() {
  echo "$1" > "$RUN/error"
  { echo "$1"; echo "--- last lines of $CONF_DIR/sunshine.log"; tail -n 25 "$CONF_DIR/sunshine.log" 2>/dev/null; } > "$RUN/error.log"
  notify "$1 — open the Virtual Screens panel to report it"
}

# Our Sunshine is running: the saved pid is alive AND is still Sunshine (pids get reused).
running() {
  local pid
  [[ -f $RUN/pid ]] || return 1
  pid=$(<"$RUN/pid")
  [[ $pid =~ ^[0-9]+$ ]] && [[ $(cat "/proc/$pid/comm" 2>/dev/null) == sunshine* ]]
}
have_output() { hyprctl monitors all -j | jq -e --arg n "$NAME" 'any(.[]; .name == $n)' >/dev/null; }

make_output() {
  have_output || hyprctl output create headless "$NAME" >/dev/null
  sleep 0.5
}

# Start/stop/audio for one screen run one at a time, holding $RUN/lock. While
# it is held the panel shows the screen as busy and keeps its row locked.
lock_screen() {
  exec 9>>"$RUN/lock"
  flock 9
}
is_busy() { ! flock -n "$RUN/lock" true 2>/dev/null; }

# ---- login --------------------------------------------------------------------

ensure_login() {
  if [[ ! -s $LOGIN_FILE ]]; then
    mkdir -p "$CONF_ROOT"
    ( umask 077; printf 'omarchy %s\n' "$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24)" > "$LOGIN_FILE" )
  fi
  chmod 600 "$LOGIN_FILE"
  read -r USER_NAME USER_PASS < "$LOGIN_FILE"
}

# Sunshine's own way to set the Web UI login, `sunshine --creds`, takes the
# password as command line arguments, where any other local account can read
# it (/proc/<pid>/cmdline). Instead the login is written straight into the
# instance's state file, in Sunshine's own format: a random salt, and the
# password stored as SHA-256(password + salt), hex-encoded upper case with the
# digest's bytes in reverse order (save_user_creds in src/httpcommon.cpp, Hex
# in src/utility.h; unchanged from Sunshine 0.20 through at least 0.23).
sunshine_hash() {  # sunshine_hash PASSWORD SALT
  local hex rev="" i
  hex=$(printf '%s%s' "$1" "$2" | sha256sum | cut -d' ' -f1)
  for ((i = 62; i >= 0; i -= 2)); do rev+="${hex:i:2}"; done
  printf '%s' "${rev^^}"
}

# Write our login into this instance's state file. The password itself only
# ever travels through shell variables and stdin, never a process's arguments.
set_login_state() {  # write our login into this instance's Sunshine state file
  local st="$CONF_DIR/sunshine_state.json" salt hash
  salt=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 16)
  hash=$(sunshine_hash "$USER_PASS" "$salt")
  # Don't clobber a state file Sunshine itself couldn't read either.
  [[ ! -s $st ]] || jq . "$st" >/dev/null 2>&1 || return 1
  ( umask 077
    if [[ -s $st ]]; then
      jq --arg u "$USER_NAME" --arg s "$salt" --arg p "$hash" \
        '.username = $u | .salt = $s | .password = $p' "$st" > "$st.new"
    else
      jq -nc --arg u "$USER_NAME" --arg s "$salt" --arg p "$hash" \
        '{username: $u, salt: $s, password: $p}' > "$st.new"
    fi
    mv "$st.new" "$st"
  ) || { rm -f "$st.new"; return 1; }
}

# Sunshine's certificate is self-signed (its name never matches 127.0.0.1),
# so instead of normal verification curl is pinned to the public key of this
# instance's own certificate, which lives in our 0700 config dir. Another local
# account that grabs the API port first can't present that key, so curl drops
# the connection before sending the login. No certificate yet → no request.
api_pin() {
  local cert="$CONF_DIR/credentials/cacert.pem"
  [[ -s $cert ]] || return 1
  local key
  key=$(openssl x509 -in "$cert" -pubkey -noout 2>/dev/null) && [[ $key == *"PUBLIC KEY"* ]] || return 1
  printf 'sha256//%s' "$(openssl pkey -pubin -outform der <<<"$key" | openssl dgst -sha256 -binary | base64)"
}

# The login goes to curl on stdin (-K -), so it never shows up in `ps`.
curl_api() {
  local pin; pin=$(api_pin) || return 1
  printf 'user = "%s:%s"\n' "$USER_NAME" "$USER_PASS" | curl -K - -sk --pinnedpubkey "$pin" "$@"
}

api() {  # api METHOD PATH [JSON]
  local args=(--max-time 15 -X "$1" "$API$2")
  [[ -n ${3:-} ]] && args+=(-H 'Content-Type: application/json' -d "$3")
  curl_api "${args[@]}"
}

login_ok() { [[ $(curl_api --max-time 5 -o /dev/null -w '%{http_code}' "$API/api/clients/list") == 200 ]]; }

# ---- config -------------------------------------------------------------------

# Hardware video encoder: Intel/AMD through VA-API first (lighter on hybrid
# laptops), NVIDIA's NVENC otherwise. Override with
# ~/.config/virtual-screens/sunshine-extra.conf (appended to every instance).
encoder_lines() {
  local dev vendor nvidia=""
  for dev in /sys/class/drm/renderD*; do
    [[ -e $dev/device/vendor ]] || continue
    vendor=$(<"$dev/device/vendor")
    case $vendor in
      0x8086|0x1002) printf 'encoder = vaapi\nadapter_name = /dev/dri/%s\n' "${dev##*/}"; return ;;
      0x10de) nvidia=1 ;;
    esac
  done
  [[ -n $nvidia ]] && echo "encoder = nvenc"
}

write_config() {
  mkdir -p "$CONF_DIR/credentials"
  local audio=disabled
  grep -q '^stream_audio = enabled' "$CONF" 2>/dev/null && audio=enabled
  {
    cat <<EOF
# Written by virtual-screen on every start; put your own settings in
# $CONF_ROOT/sunshine-extra.conf instead.
sunshine_name = $(hostname)-screen-$N
port = $BASE
output_name = $NAME
capture = wlr
$(encoder_lines)
origin_web_ui_allowed = pc
upnp = disabled
stream_audio = $audio
file_state = $CONF_DIR/sunshine_state.json
credentials_file = $CONF_DIR/sunshine_state.json
file_apps = $CONF_DIR/apps.json
log_path = $CONF_DIR/sunshine.log
pkey = $CONF_DIR/credentials/cakey.pem
cert = $CONF_DIR/credentials/cacert.pem
# Resize SCREEN-$N to the device's resolution when it connects.
global_prep_cmd = [{"do":"bash $SELF $N fit","undo":""}]
EOF
    [[ -f $CONF_ROOT/sunshine-extra.conf ]] && cat "$CONF_ROOT/sunshine-extra.conf"
  } > "$CONF.new"
  mv "$CONF.new" "$CONF"
  [[ -f $CONF_DIR/apps.json ]] || echo '{"env":{},"apps":[{"name":"Desktop","image-path":"desktop.png"}]}' > "$CONF_DIR/apps.json"
  # Set the login on this instance whenever the saved one is new to it (once
  # per new login), by writing its state file — never through
  # `sunshine --creds`, whose arguments any local account could read.
  local mark; mark=$(sha256sum "$LOGIN_FILE" | cut -c1-16)
  if [[ $(cat "$CONF_DIR/.login-set" 2>/dev/null) != "$mark" ]]; then
    set_login_state && echo "$mark" > "$CONF_DIR/.login-set"
  fi
}

# ---- start / stop ---------------------------------------------------------------

# Stop this screen's Sunshine and wait (up to 5 s) until it has exited and
# freed its ports, instead of sleeping a fixed time.
stop_sunshine() {
  local pid i
  running || return 0
  pid=$(<"$RUN/pid")
  kill "$pid" 2>/dev/null
  for i in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.1; done
  kill -9 "$pid" 2>/dev/null
}

launch_sunshine() {
  sunshine "$CONF" >/dev/null 2>&1 9>&- &   # 9>&-: Sunshine must not hold the screen lock
  echo $! > "$RUN/pid"
}

# Wait up to 10 s for Sunshine to answer with our login.
wait_login() {
  local i
  for i in $(seq 1 20); do running || return 1; login_ok && return 0; sleep 0.5; done
  return 1
}

# Addresses a device can use: USB tethering links, plus Wi-Fi while the trusted
# Wi-Fi rules are open. Format: "KIND ADDRESS" per line.
addresses() {
  local ifc addr
  while read -r ifc _ addr _; do
    [[ $addr =~ ^[0-9.]+/ ]] || continue
    case $ifc in
      tether*) echo "USB ${addr%/*}" ;;
      wl*) [[ -e $WIFI_FLAG ]] && echo "Wi-Fi ${addr%/*}" ;;
    esac
  done < <(ip -4 -br addr)
}

start() {
  command -v sunshine >/dev/null || { notify "Sunshine is not installed. Open the Virtual Screens panel and press Set up."; return 1; }
  rm -f "$RUN/error" "$RUN/error.log"
  ensure_login
  write_config
  make_output
  launch_sunshine
  if ! wait_login; then
    if running; then  # login out of step (state file replaced): set it again
      stop_sunshine
      rm -f "$CONF_DIR/.login-set"; write_config; launch_sunshine
      wait_login || { fail "Sunshine started but didn't accept the login"; stop quiet; return 1; }
    else
      fail "Sunshine failed to start"; stop quiet; return 1
    fi
  fi
  local where
  where=$(addresses | awk -v p=":$BASE" '{printf "%s%s %s%s", (NR>1?", ":""), $1, $2, p}')
  notify "On — in Moonlight, add this PC${where:+: $where}"
}

stop() {
  stop_sunshine
  rm -f "$RUN/pid"
  have_output && hyprctl output remove "$NAME" >/dev/null
  [[ ${1:-} == quiet ]] || notify "Off"
}

# Hyprland only takes a scale that divides the resolution into whole pixels.
# Pick the largest such scale up to the one we want.
pick_scale() {
  local w=$1 h=$2 want=$3
  awk -v w="$w" -v h="$h" -v want="$want" 'BEGIN {
    n = split("2 1.875 1.75 1.6 1.5 1.25 1.2 1", s, " ")
    for (i = 1; i <= n; i++) {
      if (s[i] > want) continue
      x = w / s[i]; y = h / s[i]
      if (x == int(x) && y == int(y)) { print s[i]; exit }
    }
    print 1
  }'
}

# Sunshine runs this before a stream starts, with the device's requested size.
fit() {
  local w=${SUNSHINE_CLIENT_WIDTH:-} h=${SUNSHINE_CLIENT_HEIGHT:-} fps=${SUNSHINE_CLIENT_FPS:-60} want=1 scale
  [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ && $fps =~ ^[0-9]+$ ]] || exit 0
  # Roughly "same text size as a laptop".
  if (( w >= 2400 )); then want=2; elif (( w >= 1900 )); then want=1.5; fi
  scale=$(pick_scale "$w" "$h" "$want")
  hyprctl eval "hl.monitor({ output = \"$NAME\", mode = \"${w}x${h}@${fps}\", position = \"auto-right\", scale = $scale })" >/dev/null 2>&1
  sleep 0.5
  exit 0
}

# ---- devices --------------------------------------------------------------------

status_ok() { jq -e '.status == true or .status == "true"' <<<"$1" >/dev/null 2>&1; }
client_uuids() { api GET /api/clients/list | jq -r '.named_certs[]?.uuid' | sort; }

# Success is a NEW client in Sunshine's list, not just an accepted PIN:
# Sunshine can accept a PIN and save nothing.
pair() {
  local pin=${1:-} name=${2:-}
  [[ $pin =~ ^[0-9]{4}$ ]] || { echo "The PIN is the 4 digits Moonlight shows"; return 2; }
  name=$(printf '%s' "$name" | tr -cd '[:alnum:] ._-' | head -c 32)
  name="${name#"${name%%[! ]*}"}"
  [[ -n ${name// /} ]] || name="$(ordinal "$N") screen device"
  running || { echo "Turn the screen on first"; return 2; }
  ensure_login
  local before ids="" accepted=false body resp i id
  before=$(client_uuids)
  for i in $(seq 1 5); do  # the request may still be on its way
    ids=$(api GET /api/pin | jq -r '.pairings[]?.id | tostring' 2>/dev/null)
    [[ -n $ids ]] && break
    sleep 1
  done
  if [[ -n $ids ]]; then
    for id in $(tac <<<"$ids"); do  # newest first; only the right one takes the PIN
      body=$(jq -nc --arg id "$id" --arg pin "$pin" --arg name "$name" '{pairing_id:$id, pin:$pin, name:$name}')
      resp=$(api POST /api/pin "$body")
      status_ok "$resp" && { accepted=true; break; }
    done
    $accepted || { echo "Sunshine didn't take that PIN. Check the 4 digits in Moonlight and try again."; return 1; }
  else  # older Sunshine API without pairing ids, or Moonlight isn't asking
    resp=$(api POST /api/pin "$(jq -nc --arg pin "$pin" --arg name "$name" '{pin:$pin, name:$name}')")
    status_ok "$resp" && accepted=true
    $accepted || { echo "Moonlight isn't waiting for a PIN. In Moonlight tap this PC, then type the PIN it shows."; return 1; }
  fi
  for i in $(seq 1 15); do
    [[ -n $(comm -13 <(echo "$before") <(client_uuids)) ]] && { echo "Paired: $name"; return 0; }
    sleep 1
  done
  echo "Sunshine took the PIN but saved no device. Try pairing again."; return 1
}

forget() {
  local uuid=${1:-} st="$CONF_DIR/sunshine_state.json" resp
  [[ $uuid =~ ^[A-Za-z0-9-]+$ ]] || { echo "usage: virtual-screen $N forget UUID"; return 2; }
  if running; then
    ensure_login
    resp=$(api POST /api/clients/unpair "$(jq -nc --arg u "$uuid" '{uuid:$u}')")
    status_ok "$resp" || { echo "Sunshine didn't forget the device. Try again."; return 1; }
  elif [[ -f $st ]]; then
    jq --arg u "$uuid" '.root.named_devices |= map(select(.uuid != $u))' "$st" > "$st.new" && mv "$st.new" "$st" ||
      { rm -f "$st.new"; echo "Couldn't edit $st"; return 1; }
  fi
  echo "Forgot the device"
}

set_audio() {
  local val
  case "${1:-}" in
    laptop) val=disabled ;;
    device) val=enabled ;;
    *) echo "usage: virtual-screen $N audio laptop|device"; return 2 ;;
  esac
  [[ -f $CONF ]] || { ensure_login; write_config; }
  sed -i "s/^stream_audio = .*/stream_audio = $val/" "$CONF"
  # Sunshine reads its config at start: restart it if it is streaming now.
  if running; then
    stop_sunshine
    launch_sunshine
    if wait_login; then
      notify "Sound on the $1 — reconnect in Moonlight (tap the PC → Desktop)"
    else
      fail "Sunshine didn't come back after the sound change"; stop quiet; return 1
    fi
  else
    notify "Sound on the $1"
  fi
}

# ---- reporting ------------------------------------------------------------------

# A pre-filled "new issue" URL. It opens in the browser, so the user reads and
# edits it before anything is sent. GitHub refuses URLs much over 8 KB, so the
# details are cut until it fits.
issue_url() {
  local title=$1 details=$2 plugin omarchy sunshine fence='```' body url snip keep=3000
  plugin=$(jq -r .version "$BIN_DIR/../manifest.json" 2>/dev/null)
  omarchy=$(omarchy version 2>/dev/null | head -n 1)
  sunshine=$(pacman -Q sunshine 2>/dev/null | cut -d' ' -f2)
  title=${title:0:200}
  while :; do
    # Keep the end of the details: the last log lines matter most.
    if (( ${#details} > keep )); then snip="…${details: -keep}"; else snip=$details; fi
    body="## What happened
$title

## Details
$fence
$snip
$fence

## System
- Virtual Screens: ${plugin:-unknown}
- Omarchy: ${omarchy:-unknown}
- Sunshine: ${sunshine:-not installed}
- Kernel: $(uname -r)
- Encoder: $(encoder_lines | tr '\n' ' ')

<!-- Please check the details above for anything private before submitting. -->"
    url=$(printf 'https://github.com/%s/issues/new?title=%s&body=%s' "$REPO" \
      "$(printf '%s' "$title" | jq -sRr @uri)" "$(printf '%s' "$body" | jq -sRr @uri)")
    (( ${#url} <= 7000 || keep <= 200 )) && break
    keep=$((keep * 2 / 3))
  done
  echo "$url"
}

report() {
  local title details
  title="$TITLE: $(head -n 1 "$RUN/error" 2>/dev/null || echo "failed")"
  details=$(cat "$RUN/error.log" 2>/dev/null)
  issue_url "$title" "$details"
}

# ---- uninstall ------------------------------------------------------------------

# Everything in one go: screens off, the system part (password), this user's
# configs and pairings, then the plugin itself.
uninstall() {
  local s helper rc
  TITLE="Virtual screens"
  for s in "${SCREENS[@]}"; do setup "$s"; stop quiet; done
  if [[ -e $SYS_DIR || -e $LIBEXEC ]]; then
    if [[ -x $LIBEXEC ]]; then helper=("$LIBEXEC"); else helper=(bash "$BIN_DIR/virtual-screen-root"); fi
    pkexec "${helper[@]}" uninstall; rc=$?
    if (( rc == 126 )); then notify "Uninstall cancelled"; return 1; fi
    if (( rc != 0 )); then notify "Uninstall failed (exit $rc): firewall and USB pieces are still there"; return 1; fi
  fi
  rm -rf "$CONF_ROOT" "$RUN_ROOT"
  if [[ -d ${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$PLUGIN_ID ]]; then
    omarchy plugin remove "$PLUGIN_ID" --yes >/dev/null || { notify "Couldn't remove the plugin: run omarchy plugin remove $PLUGIN_ID"; return 1; }
  fi
  notify "Removed. Sunshine itself is still installed (omarchy pkg drop sunshine removes it)."
}

# ---- panel ----------------------------------------------------------------------

info() {
  local on=false busy=false audio=laptop devices error=""
  running && on=true
  is_busy && busy=true
  [[ -f $RUN/error ]] && error=$(head -n 1 "$RUN/error")
  grep -q '^stream_audio = enabled' "$CONF" 2>/dev/null && audio=device
  devices=$(jq -c '[.root.named_devices[]? | {name, uuid}]' "$CONF_DIR/sunshine_state.json" 2>/dev/null) || devices='[]'
  [[ -n $devices ]] || devices='[]'
  jq -nc --argjson n "$N" --arg title "$TITLE" --argjson on "$on" --argjson busy "$busy" --arg audio "$audio" \
     --arg port "$BASE" --argjson devices "$devices" --arg error "$error" --argjson addrs "$ADDRS" \
     '{n: $n, title: $title, on: $on, busy: $busy, audio: $audio, port: ($port | tonumber), error: $error,
       addresses: [$addrs[] | .addr += (":" + $port)], devices: $devices}'
}

# Everything the panel shows, in one call.
info_all() {
  local screens wifi_uuid="" wifi_name="" trusted=false sunshine=false system=false update=false ver=""
  ADDRS=$(addresses | jq -Rnc '[inputs | split(" ") | {kind: .[0], addr: .[1]}]')
  screens=$(for s in "${SCREENS[@]}"; do setup "$s"; info; done | jq -sc .)
  command -v sunshine >/dev/null && sunshine=true
  if [[ -f $SYS_DIR/version ]]; then
    system=true
    ver=$(<"$SYS_DIR/version")
    [[ $ver == "$SYSTEM_VERSION" ]] || update=true
  fi
  # -g escapes ":" inside fields, so ask for the name separately, unescaped.
  wifi_uuid=$(nmcli -g UUID,TYPE con show --active 2>/dev/null | awk -F: '$NF == "802-11-wireless" {print $1; exit}')
  if [[ -n $wifi_uuid ]]; then
    wifi_name=$(nmcli -e no -g connection.id con show uuid "$wifi_uuid" 2>/dev/null)
    grep -qx "$wifi_uuid" "$SYS_DIR/trusted-wifi" 2>/dev/null && trusted=true
  fi
  jq -nc --argjson screens "$screens" --argjson sunshine "$sunshine" --argjson system "$system" \
     --argjson update "$update" \
     --arg wname "$wifi_name" --arg wuuid "$wifi_uuid" --argjson trusted "$trusted" \
     --argjson open "$([[ -e $WIFI_FLAG ]] && echo true || echo false)" \
     '{loaded: true, screens: $screens, ready: ($sunshine and $system), sunshine: $sunshine, system: $system,
       update: $update,
       wifi: (if $wuuid == "" then null else {name: $wname, uuid: $wuuid, trusted: $trusted, open: $open} end)}'
}

# ---- main -----------------------------------------------------------------------

case ${1:-} in
  status-all)
    for s in "${SCREENS[@]}"; do setup "$s"; running && echo "$s on" || echo "$s off"; done
    exit 0 ;;
  info-all) info_all; exit 0 ;;
  issue-url) issue_url "${2:-Virtual Screens problem}" "${3:-}"; exit 0 ;;
  uninstall) uninstall; exit ;;
esac

n=2
if [[ ${1:-} =~ ^[0-9]+$ ]]; then n=$1; shift; fi
[[ " ${SCREENS[*]} " == *" $n "* ]] || { echo "screen must be one of: ${SCREENS[*]}"; exit 1; }
setup "$n"

case "${1:-toggle}" in
  start) lock_screen; running && notify "Already on" || start ;;
  stop) lock_screen; stop ;;
  toggle) lock_screen; if running; then stop; else start; fi ;;
  status) running && echo on || echo off ;;
  pair) pair "${2:-}" "${3:-}" ;;
  forget) forget "${2:-}" ;;
  audio) lock_screen; set_audio "${2:-}" ;;
  fit) fit ;;
  report) report ;;
  info) ADDRS=$(addresses | jq -Rnc '[inputs | split(" ") | {kind: .[0], addr: .[1]}]'); info ;;
  *) echo "usage: virtual-screen [2|3|4] [start|stop|toggle|status|pair PIN [NAME]|forget UUID|audio laptop|device] | info-all | status-all | uninstall"; exit 1 ;;
esac
